{
    "name": "opensid/laravel-filemanager",
    "description": "Storage/Flysystem-backed Laravel file manager package, derived from Responsive Filemanager",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "keywords": [
        "opensid",
        "laravel",
        "filemanager"
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "spatie/image": "^3.0",
        "spatie/laravel-package-tools": "^1.16|^1.92"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenSID\\LaravelFilemanager\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSID\\LaravelFilemanager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenSID\\LaravelFilemanager\\LaravelFilemanagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
